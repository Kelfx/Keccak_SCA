    "corrs = np.array(corrs)\n",
    "\n",
    "top_k_POI = np.argsort(np.abs(corrs))[-50:]\n",
    "print(\"Best 50 POIs:\", top_k_POI)\n",
    "print(\"Max correlation found:\", np.max(np.abs(corrs)))"
